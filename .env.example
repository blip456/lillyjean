# Copy to .env.local and fill in. Values for local dev come from `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Google Books API key for a higher quota (fallback search and Google ratings).
GOOGLE_BOOKS_API_KEY=

# Local development and end-to-end checks only: `fixtures` uses offline book data instead of
# Open Library and Google Books. Never set this on Vercel.
BOOKS_API=

# Server only (never NEXT_PUBLIC_): lets the server copy book covers into Supabase Storage (T20).
# Without it covers keep loading from the book databases.
SUPABASE_SECRET_KEY=
